    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $json;\nconst lineItems = Array.isArray(data.lineItems) ? data.lineItems : [];\n\nconst calculatedSubtotal = lineItems.reduce((sum, item) => {\n  const lineTotal = Number(item.lineTotal ?? (Number(item.quantity || 0) * Number(item.unitPrice || 0)));\n  return sum + (Number.isFinite(lineTotal) ? lineTotal : 0);\n}, 0);\n\nconst extractedSubtotal = Number(data.subtotal || 0);\nconst extractedTotal = Number(data.totalAmount || 0);\nconst taxAmount = Number(data.taxAmount || 0);\n\nconst subtotalMatches = Math.abs(calculatedSubtotal - extractedSubtotal) < 0.01;\nconst calculatedTotal = calculatedSubtotal + taxAmount;\nconst totalMatches = Math.abs(calculatedTotal - extractedTotal) < 0.01;\n\nreturn {\n  json: {\n    ...data,\n    calculatedSubtotal: Number(calculatedSubtotal.toFixed(2)),\n    calculatedTotal: Number(calculatedTotal.toFixed(2)),\n    subtotalMatches,\n    totalMatches,\n    isVerified: subtotalMatches && totalMatches\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        304
